datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Anggota {
  id           String          @id // NPA (Nomor Pokok Anggota), e.g. "23.0001"
  name         String
  status       String          // 'Aktif' | 'Tidak Aktif' | 'Alumni'
  tempatLahir  String?
  tanggalLahir String?
  alamat       String?
  pekerjaan    String?
  whatsapp     String?
  email        String
  profilePhoto String?         @map("profile_photo")
  pimhar       Pimhar?
  bidang       AnggotaBidang?
  akunLogin    AkunLogin?

  @@map("anggota")
}

model Penasehat {
  id        Int    @id @default(autoincrement())
  name      String
  sortOrder Int    @map("sort_order")

  @@map("penasehat")
}

model Pimhar {
  roleKey   String  @id @map("role_key") // 'ketua', 'wakil_ketua', 'sekretaris', 'wakil_sekretaris', 'bendahara', 'wakil_bendahara'
  anggotaId String? @unique @map("anggota_id")
  anggota   Anggota? @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@map("pimhar")
}

model Bidang {
  id      String          @id @default(uuid())
  name    String
  members AnggotaBidang[]

  @@map("bidang")
}

model AnggotaBidang {
  id        String @id @default(uuid())
  bidangId  String @map("bidang_id")
  anggotaId String @unique @map("anggota_id")
  bidang    Bidang @relation(fields: [bidangId], references: [id], onDelete: Cascade)
  anggota   Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@map("anggota_bidang")
}

model RoleAkses {
  roleName             String  @id @map("role_name")
  allowDashboard       Boolean @default(true) @map("allow_dashboard")
  viewDataAnggota      Boolean @default(false) @map("view_data_anggota")
  manageDataAnggota    Boolean @default(false) @map("manage_data_anggota")
  viewTasykil          Boolean @default(false) @map("view_tasykil")
  manageTasykil        Boolean @default(false) @map("manage_tasykil")
  viewCalonAnggota     Boolean @default(false) @map("view_calon_anggota")
  manageCalonAnggota   Boolean @default(false) @map("manage_calon_anggota")
  viewJadwalKegiatan   Boolean @default(true) @map("view_jadwal_kegiatan")
  manageJadwalKegiatan Boolean @default(false) @map("manage_jadwal_kegiatan")
  viewPengaturan       Boolean @default(false) @map("view_pengaturan")
  managePengaturan     Boolean @default(false) @map("manage_pengaturan")
  akunLogins           AkunLogin[]

  @@map("role_akses")
}

model AkunLogin {
  id              String    @id @default(uuid())
  npa             String    @unique  // NPA or Username for login (e.g. "26.0000")
  name            String
  passwordHash    String    @map("password_hash")
  role            String    @default("Anggota")
  linkedAnggotaId String?   @unique @map("linked_anggota_id")
  anggota         Anggota?  @relation(fields: [linkedAnggotaId], references: [id], onDelete: SetNull)
  roleAkses       RoleAkses @relation(fields: [role], references: [roleName], onDelete: Restrict)

  @@map("akun_login")
}

model ScheduledEvent {
  id                String  @id @default(uuid())
  title             String
  date              String  // YYYY-MM-DD
  time              String  // HH:mm
  location          String
  color             String  // e.g. 'blue', 'amber', 'emerald', 'purple', 'red'
  type              String  @default("umum")
  speaker           String?
  theme             String?
  notificationCount Int     @default(0) @map("notification_count")

  @@map("scheduled_event")
}

model WaQueue {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  to        String
  message   String    @db.Text
  status    String    @default("pending") // 'pending' | 'sent' | 'failed'
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")
  error     String?   @map("error")

  @@map("wa_queue")
}

model Applicant {
  id           String @id @default(uuid())
  name         String
  date         String // YYYY-MM-DD
  contact      String // WhatsApp number
  status       String // 'Menunggu' | 'Proses' | 'Diterima' | 'Ditolak'
  tempatLahir  String
  tanggalLahir String
  alamat       String
  pekerjaan    String

  @@map("applicant")
}

model WaTemplate {
  id      String @id @default("default")
  content String

  @@map("wa_template")
}

model SystemSetting {
  key   String @id
  value String @db.Text

  @@map("system_setting")
}
